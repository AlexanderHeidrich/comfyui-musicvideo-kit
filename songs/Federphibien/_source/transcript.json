 "segments": [
  {
   "start": 0.0,
   "end": 20.7,
   "text": "Ich bin traurig vom Rand vom Teich"
  },
  {
   "start": 19.2,
   "end": 23.58,
   "text": "Ich bin ruhig vom Rand vom Teich, meine Haut ist glipschig und trotzdem weich"
  },
  {
   "start": 23.58,
   "end": 29.68,
   "text": "Die Fliegen schwirren um mein Gesicht, ich könnte sie fressen, aber Hunger hab ich nicht"
  },
  {
   "start": 30.0,
   "end": 36.94,
   "text": "Sie sagt, meine Augen sind zu groß"
  },
  {
   "start": 36.94,
   "end": 42.32,
   "text": "Sie erst am bliebieren, was ist da los?"
  },
  {
   "start": 44.1,
   "end": 46.76,
   "text": "Ich bin ein Frott, was soll ich tun?"
  },
  {
   "start": 46.76,
   "end": 50.5,
   "text": "Bin nackt, verknallt in ein Huhn, nur zu retten"
  },
  {
   "start": 50.5,
   "end": 55.24,
   "text": "Weit auseinander, doch bestimmt nur füreinander"
  },
  {
   "start": 55.24,
   "end": 60.26,
   "text": "Stell dir unsere Kinder vor"
  },
  {
   "start": 60.26,
   "end": 66.06,
   "text": "Kleinige Fäder, große Augen"
  },
  {
   "start": 66.06,
   "end": 70.68,
   "text": "Liebling zum Fliegen oder Schwimmen tausend"
  },
  {
   "start": 70.68,
   "end": 73.32,
   "text": "Fäder, wie man sie nennt"
  },
  {
   "start": 73.32,
   "end": 76.38,
   "text": "Nachkümmlinge von Rausch und Herde"
  },
  {
   "start": 76.38,
   "end": 78.46,
   "text": "Hey!"
  },
  {
   "start": 80.46,
   "end": 81.34,
   "text": "Hey!"
  },
  {
   "start": 81.58,
   "end": 84.04,
   "text": "Ich denk' mich zu mit ihren Daunen"
  },
  {
   "start": 84.04,
   "end": 86.92,
   "text": "Ich halt sie aus, ihre verrückten Launen"
  },
  {
   "start": 86.92,
   "end": 89.54,
   "text": "Sie dreht den Kopf, sie schaut mich an"
  },
  {
   "start": 89.54,
   "end": 92.72,
   "text": "Ich halt's nicht aus, nimm mich zum Mann"
  },
  {
   "start": 92.72,
   "end": 99.1,
   "text": "Mir kann einer dann frühe Echsen"
  },
  {
   "start": 99.1,
   "end": 105.04,
   "text": "Das macht mich rollig, ich will sie sechsen"
  },
  {
   "start": 105.04,
   "end": 109.24,
   "text": "Ich dreht die Körner auf mein Rücken"
  },
  {
   "start": 109.24,
   "end": 112.24,
   "text": "Sie kommt mehr, muss ich drücken"
  },
  {
   "start": 112.24,
   "end": 115.08,
   "text": "Sie liegt fertig, ich fack leise"
  },
  {
   "start": 115.08,
   "end": 117.92,
   "text": "Jede Berührung schickt mich auf eine Reise"
  },
  {
   "start": 117.92,
   "end": 123.42,
   "text": "Hörst du trug, die ungewöhnlich"
  },
  {
   "start": 123.42,
   "end": 128.06,
   "text": "Hoge und ab, wie wir auf den Quillen"
  },
  {
   "start": 128.06,
   "end": 135.54,
   "text": "Denn sieh' ich stell dir unsere Kinder vor"
  },
  {
   "start": 135.54,
   "end": 140.6,
   "text": "Bei einigen Fehlern, großen Augen"
  },
  {
   "start": 140.6,
   "end": 145.1,
   "text": "Liebling zum Fliegen oder Schwimmen tausend"
  },
  {
   "start": 145.1,
   "end": 147.88,
   "text": "Fäder, wie man sie nennt"
  },
  {
   "start": 147.88,
   "end": 151.1,
   "text": "Nachkümmlinge von Rausch und Herde"
  },
  {
   "start": 151.1,
   "end": 166.98,
   "text": "Hörst du trug, die ungewöhnlich ist, ihre Erste und Herde"
  },
  {
   "start": 166.98,
   "end": 196.96,
   "text": "Vertraue und glaube, es hilft, es heilt die göttliche Kraft!"
  }
