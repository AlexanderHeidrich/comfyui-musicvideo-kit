 "segments": [
  {
   "start": 0.0,
   "end": 20.28,
   "text": "Ich bin sehr traurig, hab' kaputt vom Teich"
  },
  {
   "start": 20.28,
   "end": 23.22,
   "text": "Meine Haut ist glipsisch und trotzdem weich"
  },
  {
   "start": 23.22,
   "end": 25.94,
   "text": "Die Fliegen schwören noch mal ein Gesicht"
  },
  {
   "start": 25.94,
   "end": 29.32,
   "text": "Ich kann sie pressen, aber Hunger hab ich nicht"
  },
  {
   "start": 29.32,
   "end": 36.44,
   "text": "Sie sagt, meine Augen sind zu groß"
  },
  {
   "start": 36.44,
   "end": 41.7,
   "text": "Seh erst am Fibien, was ist da los?"
  },
  {
   "start": 43.68,
   "end": 46.4,
   "text": "Ich bin ein Frosch, was soll ich tun?"
  },
  {
   "start": 46.9,
   "end": 49.82,
   "text": "Bin arg verknallt, denn nun unsere Welt"
  },
  {
   "start": 49.82,
   "end": 54.82,
   "text": "Weit auseinander, doch bestimmt nur füreinander"
  },
  {
   "start": 54.82,
   "end": 58.64,
   "text": "Stell dir unsere Kinder vor"
  },
  {
   "start": 58.64,
   "end": 65.76,
   "text": "Schleimtige Federn, große Augen"
  },
  {
   "start": 65.76,
   "end": 69.92,
   "text": "Geht weg zum Fliegen, rolle Schwimmenshaufen"
  },
  {
   "start": 69.92,
   "end": 72.88,
   "text": "Federn, wie den Goldmann sie nennen"
  },
  {
   "start": 72.88,
   "end": 83.0,
   "text": "Ich denk mich zu, mit ihren Daunen"
  },
  {
   "start": 83.0,
   "end": 86.0,
   "text": "Ich heiz sie aus, ihre verrückten Launen"
  },
  {
   "start": 86.0,
   "end": 89.12,
   "text": "Sie dreht den Kopf, sie schaut mich an"
  },
  {
   "start": 89.12,
   "end": 92.24,
   "text": "Ich heiz nicht aus, ich heiz nicht aus, nimm mich zum Mann"
  },
  {
   "start": 92.24,
   "end": 99.36,
   "text": "Ihr Gang erinnert an Uhrzeit, der Gang erinnert an Uhrzeitechst"
  },
  {
   "start": 99.36,
   "end": 104.48,
   "text": "Das macht mich rollig, ich will sie sexen"
  },
  {
   "start": 104.48,
   "end": 111.6,
   "text": "Die linke Körner, sie kommt näher und muss ich spüren"
  },
  {
   "start": 111.6,
   "end": 117.72,
   "text": "Den Blick beklärt, wenn ich verkleise, jede Berührung schickt mich auf eine Reise"
  },
  {
   "start": 117.72,
   "end": 123.84,
   "text": "Wasch und tut, wie ungewöhnlich"
  },
  {
   "start": 123.84,
   "end": 128.96,
   "text": "Vogel und Tampi und Tampi und Tampi und Tampi und Tampi"
  },
  {
   "start": 128.96,
   "end": 135.08,
   "text": "Ich stell dir unsere Kinder vor"
  },
  {
   "start": 135.08,
   "end": 140.12,
   "text": "Schleimtige Federn, große Augen"
  },
  {
   "start": 140.12,
   "end": 144.08,
   "text": "Geht weg zum Fliegen oder Schwimmenshaufen"
  },
  {
   "start": 144.08,
   "end": 147.08,
   "text": "Federn, wie den Goldmann sie nennen"
  },
  {
   "start": 147.08,
   "end": 150.08,
   "text": "Nach Kömmlingen von Frosch und Birnen"
  },
